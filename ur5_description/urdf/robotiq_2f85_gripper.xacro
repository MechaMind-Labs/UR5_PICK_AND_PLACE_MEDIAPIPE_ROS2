<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- Robotiq 2F-85 Gripper Macro -->
  <xacro:macro name="robotiq_2f85_gripper" params="prefix parent *origin">
    
    <!-- Gripper Base Link -->
    <link name="${prefix}gripper_base_link">
      <visual>
        <geometry>
          <box size="0.05 0.08 0.03"/>
        </geometry>
        <material name="grey">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.05 0.08 0.03"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.63"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>

    <!-- Joint connecting gripper to parent (typically robot tool0) -->
    <joint name="${prefix}gripper_base_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}gripper_base_link"/>
    </joint>

    <!-- Left Finger -->
    <link name="${prefix}left_finger">
      <visual>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <geometry>
          <box size="0.01 0.015 0.08"/>
        </geometry>
        <material name="black">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <geometry>
          <box size="0.01 0.015 0.08"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- Right Finger -->
    <link name="${prefix}right_finger">
      <visual>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <geometry>
          <box size="0.01 0.015 0.08"/>
        </geometry>
        <material name="black">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <geometry>
          <box size="0.01 0.015 0.08"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- Left Finger Joint -->
    <joint name="${prefix}left_finger_joint" type="prismatic">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}left_finger"/>
      <origin xyz="0 0.02 0.015" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="0.04" effort="100.0" velocity="0.1"/>
      <dynamics damping="0.5" friction="0.5"/>
    </joint>

    <!-- Right Finger Joint -->
    <joint name="${prefix}right_finger_joint" type="prismatic">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}right_finger"/>
      <origin xyz="0 -0.02 0.015" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="0.0" upper="0.04" effort="100.0" velocity="0.1"/>
      <dynamics damping="0.5" friction="0.5"/>
      <mimic joint="${prefix}left_finger_joint" multiplier="1"/>
    </joint>

    <!-- Gripper TCP (Tool Center Point) -->
    <link name="${prefix}gripper_tcp"/>
    <joint name="${prefix}gripper_tcp_joint" type="fixed">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}gripper_tcp"/>
      <origin xyz="0 0 0.095" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>