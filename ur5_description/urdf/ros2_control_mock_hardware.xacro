<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find ur5_description)/urdf/inc/ur_joint_control.xacro" />

  <xacro:macro name="ur_ros2_control" params="
    name
    tf_prefix
    initial_positions:=${dict(shoulder_pan_joint=0.0,shoulder_lift_joint=-1.57,elbow_joint=0.0,wrist_1_joint=-1.57,wrist_2_joint=0.0,wrist_3_joint=0.0)}
    ">

    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>ign_ros2_control/IgnitionSystem</plugin>
      </hardware>

      <!-- UR5 arm — 6 DOF -->
      <xacro:ur_joint_control_description
        tf_prefix="${tf_prefix}"
        initial_positions="${initial_positions}"
      />

      <!--
        Robotiq 2F-85 gripper joints.

        ALL revolute gripper joints (finger_joint + 5 mimic joints) must be
        declared here. Ignition Gazebo does NOT honour the URDF <mimic> tag
        in its physics engine — it simulates every revolute joint as an
        independent rigid body. Without a controller holding each one at the
        correct mimic position they are free bodies under gravity and fly apart.

        robot_state_publisher reads the <mimic> tags and computes the correct
        TF for RViz — that is purely kinematic and does NOT affect Gazebo physics.

        The gripper_mimic_controller node reads finger_joint from /joint_states,
        computes each mimic joint's target (position = finger_joint * multiplier),
        and publishes a JointTrajectory to gripper_mimic_controller/joint_trajectory
        keeping all 5 mimic joints pinned in Ignition physics.
      -->

      <!-- Actuated joint — commanded by gripper_controller -->
      <joint name="${tf_prefix}finger_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">0.725</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>

      <!-- mimic × +1 of finger_joint — held by gripper_mimic_controller -->
      <joint name="${tf_prefix}left_inner_knuckle_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">0.8757</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>

      <!-- mimic × −1 of finger_joint -->
      <joint name="${tf_prefix}left_inner_finger_joint">
        <command_interface name="position">
          <param name="min">-0.8757</param>
          <param name="max">0.0</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>

      <!-- mimic × −1 of finger_joint -->
      <joint name="${tf_prefix}right_inner_knuckle_joint">
        <command_interface name="position">
          <param name="min">-0.8757</param>
          <param name="max">0.0</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>

      <!-- mimic × +1 of finger_joint -->
      <joint name="${tf_prefix}right_inner_finger_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">0.8757</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>

      <!-- mimic × −1 of finger_joint -->
      <joint name="${tf_prefix}right_outer_knuckle_joint">
        <command_interface name="position">
          <param name="min">-0.8757</param>
          <param name="max">0.0</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>

    </ros2_control>
  </xacro:macro>
</robot>
